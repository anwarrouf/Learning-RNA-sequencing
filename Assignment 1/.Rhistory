plot <- barplot(die_faces,
xlab = "die faces",
ylab = "probability",
ylim = c(0,0.2),
breaks = seq(0,0.2,by = 0.05), # for intervals in y axis
abline(h = 20, col = "red", lwd = 2), # adding a horizontal line i.e. intercept in y axis
axes = T,
main = "probability vs die faces" # main title
)
plot
