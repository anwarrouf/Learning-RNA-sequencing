gene_summary <- function(x){
gene_mean <- mean(x)
gene_median <- median(x)
return(list(expression_mean = gene_mean, expression_median = gene_median))
}
x <- c(350,420,580,700,450,800,900,650,300,500)
gene_summary(x)
