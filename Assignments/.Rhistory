bp_summary <- function(x){
mean_bp <- mean(x)
median_bp <- median(x)
sd_bp <- sd(x)
minimum_bp <- min(x)
maximum_bp <- max(x)
return(list(Mean = mean_bp, Median = median_bp, SD = sd_bp, Minimum = minimum_bp, Maximum = maximum_bp))
}
x <- c(120,135,140,150,125,138,145,132,128,134)
bp_summary(x)
