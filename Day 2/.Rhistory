# Problem 16: Building a Patient Data Frame
# Background: A clinical study records multiple patient attributes:• Name: Tamim, Imrul, Fiz• Age: 35, 39, 37• Number of mutations detected: 4, 1, 0• Married: TRUE, TRUE, TRUE
# Such structured data is usually stored in a data frame
# Task: Create a data frame from this data.
Tamim <- c("Age" = 35, "Number of mutations detected" = 4, "Married" = TRUE)
# Problem 16: Building a Patient Data Frame
# Background: A clinical study records multiple patient attributes:• Name: Tamim, Imrul, Fiz• Age: 35, 39, 37• Number of mutations detected: 4, 1, 0• Married: TRUE, TRUE, TRUE
# Such structured data is usually stored in a data frame
# Task: Create a data frame from this data.
Tamim <- c("Age" = 35, "Number of mutations detected" = 4, "Married" = TRUE)
Tamim <- c("Age" = 35, "Number of mutations detected" = 4, "Married" = TRUE)
Imrul <- c("Age" = 39, "Number of mutations detected" = 1, "Married" = TRUE)
Fiz <- c("Age" = 37, "Number of mutations detected" = 0, "Married" = TRUE)
data_frame <- data.frame(Tamim, Imrul, Fiz)
data_frame
# or
age <- c(35,39,37)
number_of_mutations_detected <- c(4,1,0)
married <- c(T,T,T)
data_frame <- data.frame(age,number_of_mutations_detected,married)
data_frame
row.names(data_frame) <- c("Tamim","Imrul","Fiz")
data_frame
class(data_frame$age)
class(data_frame$number_of_mutations_detected)
class(data_frame$married)
str(data_frame)
View(data_frame)
names(data_frame) <- paste("Age", "Mutations", "Married")
data_frame
# Problem 16: Building a Patient Data Frame
# Background: A clinical study records multiple patient attributes:• Name: Tamim, Imrul, Fiz• Age: 35, 39, 37• Number of mutations detected: 4, 1, 0• Married: TRUE, TRUE, TRUE
# Such structured data is usually stored in a data frame
# Task: Create a data frame from this data.
Tamim <- c("Age" = 35, "Number of mutations detected" = 4, "Married" = TRUE)
Imrul <- c("Age" = 39, "Number of mutations detected" = 1, "Married" = TRUE)
Fiz <- c("Age" = 37, "Number of mutations detected" = 0, "Married" = TRUE)
data_frame <- data.frame(Tamim, Imrul, Fiz)
data_frame
# or
age <- c(35,39,37)
number_of_mutations_detected <- c(4,1,0)
married <- c(T,T,T)
data_frame <- data.frame(age,number_of_mutations_detected,married)
data_frame
data_frame
names(data_frame) <- paste("Age", "Mutations", "Married")
data_frame
colnames(data_frame) <- c("Age", "Mutations", "Married")
data_frame
colnames(data_frame) <- c(,"Patient", "Age", "Mutations", "Married")
colnames(data_frame) <- c("Patient", "Age", "Mutations", "Married")
colnames(data_frame) <- c("Age", "Mutations", "Married")
data_frame
# or
patients <- c("Tamim", "Imrul", "Fiz")
age <- c(35,39,37)
number_of_mutations_detected <- c(4,1,0)
married <- c(T,T,T)
data_frame <- data.frame(patients, age,number_of_mutations_detected,married)
data_frame
class(data_frame$age)
class(data_frame$number_of_mutations_detected)
class(data_frame$married)
str(data_frame) # to check the structure (str function) of the data frame
View(data_frame) # to view the data frame in environment panel. Data frame will be opened as a table in environment panel
colnames(data_frame) <- c("Patient", "Age", "Mutations", "Married")
data_frame
data_frame.pop('Patient')
data_frame
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
View(data_frame$Name)
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
data_frame$Name
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
data_frame$Name
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
data_frame$Patient
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
data_frame$Patient[1,2]
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
data_frame$Patient[c(1,2)]
# Problem 19: Extracting a Subset of Data
# Background: The epidemiologist needs to quickly review the "Name" and "Age" of the first two patients for age distribution.
# Task: Use indexing to extract this sub-data frame.
data_frame[c(1,2),c(1,2)]
# Problem 20: Extracting a Single Column
# Background: A geneticist wants only the "Mutations" column to calculate mutation frequency.
# Task: Extract it using both df[,3] and df$Mutations
data_frame[,3]
data_frame$Mutations
data_frame
