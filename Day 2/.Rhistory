tamim <- c(10,100,30)
imrul <- c(20,10,100)
fiz <- c(2,1,5)
bangladesh <- matrix(data  = c(tamim,imrul,fiz), ncol = 3, byrow = TRUE)
bangladesh
rownames(bangladesh) <- c(tamim,imrul,fiz)
row.names(bangladesh) <- c(tamim,imrul,fiz)
rownames(bangladesh) <- c("tamim","imrul","fiz")
colnames(bangladesh) <- c("1st","2nd","3rd")
bangladesh
rownames(bangladesh) <- c(tamim,imrul,fiz)
bangladesh[c(2,2)]
bangladesh[1,2]
bangladesh [c(1,2)]
bangladesh [c(3,3)]
bangladesh [c((1,2),(2,2)]
bangladesh [c(1,2),(2,2)]
bangladesh [c[1,2],[2,2]
bangladesh [c[1,2],[2,2]]
bangladesh (c[1,2],[2,2])
bangladesh (c([1,2],[2,2]))
bangladesh [c((1,2),(1,3))]
# To extract multiple data from matrix
bangladesh [1, c(2,3)]
bangladesh[1, "3rd"]
# or
bangladesh["tamim","3rd"]
bangladesh[c("tamim","imrul"),c("1st","3rd")]
